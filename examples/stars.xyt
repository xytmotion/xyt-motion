// Starry night: A night sky with twinkling stars and a shooting star
duration 5
fill mix(#02030a, #18204a, y)
repeat i 80
  circle cx=hash(i) cy=hash(i + 100) r=0.002 + 0.004 * hash(i + 200) color=white alpha=0.3 + 0.7 * pingpong(t * 0.4 + hash(i + 300))
end
let s = fract(p * 1.5)
line x1=s * 1.4 - 0.2 y1=0.15 + s * 0.3 x2=s * 1.4 - 0.34 y2=0.15 + s * 0.3 - 0.03 width=0.004 color=white alpha=0.9 * (s < 0.9) blur=0.004
