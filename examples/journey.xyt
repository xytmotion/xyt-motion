// Paper plane journey: 12 seconds in 16:9, with scenes, fades, keyframes and a reusable character.
canvas 16:9
bpm 96

// The plane, drawn once. tilt is in radians; s scales it.
define plane cx=0.5 cy=0.5 s=1 tilt=0
  let c = cos(tilt)
  let n = sin(tilt)
  let nx = cx + 0.09 * s * c
  let ny = cy + 0.09 * s * n
  let tx1 = cx + (-0.09 * c + 0.035 * n) * s
  let ty1 = cy + (-0.09 * n - 0.035 * c) * s
  let tx2 = cx + (-0.09 * c - 0.03 * n) * s
  let ty2 = cy + (-0.09 * n + 0.03 * c) * s
  let fx = cx + (-0.06 * c - 0.005 * n) * s
  let fy = cy + (-0.06 * n + 0.005 * c) * s
  tri x1=nx y1=ny x2=tx1 y2=ty1 x3=fx y3=fy color=white
  tri x1=nx y1=ny x2=fx y2=fy x3=tx2 y3=ty2 color=#d4d9e6
end

// 0-4.5 s: dusk over the hills, the plane glides in
scene 0 4.5 fadein=0.6
  fill mix(#2d2363, #ff9a62, ease(y * 1.1))
  circle cx=1.3 cy=0.6 r=0.11 color=#ffd38a
  circle cx=1.3 cy=0.6 r=0.25 color=#ffb36b alpha=0.35 blur=0.25
  fill #5b3f7a alpha=smoothstep(-0.002, 0.002, y - 0.66 - 0.05 * sin(x * 5 + 1) - 0.03 * sin(x * 13))
  fill #2c2048 alpha=smoothstep(-0.002, 0.002, y - 0.78 - 0.04 * sin(x * 4) - 0.02 * sin(x * 17 + 2))
  plane cx=keys(st, 0, -0.15, 4.5, 1.15) cy=0.42 + 0.03 * sin(st * 2.2) s=1.3 tilt=0.12 * cos(st * 2.2)
end

// 4-8.5 s: above the clouds, a loop-the-loop
scene 4 8.5 fadein=0.5
  fill mix(#4d9df0, #cfe8ff, y)
  fill white alpha=smoothstep(0.55, 0.7, fbm(x * 2 + st * 0.6, y * 3)) * smoothstep(0.35, 0.9, y)
  let a = keys(st, 0, 0, 1, 0, 3, tau, 4.5, tau)
  plane cx=0.889 + 0.18 * sin(a) cy=0.32 + 0.18 * cos(a) s=1.5 tilt=-a
  fill white alpha=0.9 * smoothstep(0.6, 0.75, fbm(x * 3 + st * 1.4, y * 4 + 9)) * smoothstep(0.55, 1, y)
end

// 8-12 s: night city, the plane flies off and the stars pulse with the beat
scene 8 12 fadein=0.6 fadeout=0.8
  fill mix(#070a1f, #29204f, y)
  repeat i 40
    circle cx=hash(i) * aspect cy=hash(i + 50) * 0.55 r=0.002 + 0.003 * hash(i + 7) color=white alpha=0.35 + 0.65 * pulse * hash(i + 3)
  end
  repeat i 16
    let bw = 0.1 + 0.06 * hash(i)
    let bh = 0.18 + 0.3 * hash(i + 20)
    let lit = step(0.55, hash(floor(x * 48) * 7.1 + floor(y * 32) * 3.3 + floor(beat / 2)))
    let win = step(0.4, fract(x * 48)) * step(0.35, fract(y * 32)) * lit
    rect cx=i * 0.115 + 0.04 cy=1 - bh / 2 w=bw h=bh color=mix(mix(#232c55, #1a2045, hash(i + 4)), #ffd36b, win)
  end
  let k = easein(sp)
  plane cx=0.3 + 1.2 * k cy=0.5 - 0.3 * k s=1.2 - 0.9 * k tilt=-0.4
end
